COPILOT_EU_ROOT_URL=https://366b8031-ab7f-4a98-a1bd-3369fbd00eee-prod.e1-eu-west-cdp.choreoapis.dev/copilot
COPILOT_DEV_ROOT_URL=
COPILOT_STAGE_ROOT_URL=
# Copilot backends, one per WSO2 Cloud environment; WSO2 Integrator must name the same ones, since it exchanges the
# WSO2 Cloud token only at its own. The production regions' are public and set here. Left empty, a key is filled
# from the build's environment (CI: dev's from a secret); stage has none for now.
# The WSO2 Cloud environment WSO2 Integrator works in (prod, prod-eu, stage, dev; production's region can change
# while the editor runs) picks one of these; one with none set uses COPILOT_ROOT_URL, without signing in to
# Copilot with WSO2 Cloud.

# CHOREO_ENV = "dev"
