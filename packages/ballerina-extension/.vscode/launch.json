{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "env": {
                "LS_EXTENSIONS_PATH": "",
                "LSDEBUG": "false",
                "WEB_VIEW_WATCH_MODE": "true",
                "WEB_VIEW_DEV_HOST": "http://localhost:9000",
                "BALLERINA_STAGE_CENTRAL": "false",
                "BALLERINA_DEV_CENTRAL": "false",
                "TRACE_WEB_VIEW_DEV_HOST": "http://localhost:9001"
            },
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "preLaunchTask": "npm: watch-ballerina",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Server",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/src/debugger/index.js",
            "args": [
                "--server=4711"
            ],
            "outFiles": [
                "${workspaceFolder}/out/src/debugger/**/*.js"
            ],
        }
    ]
}
