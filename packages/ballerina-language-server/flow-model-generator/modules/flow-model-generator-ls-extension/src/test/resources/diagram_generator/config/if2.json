          "sourceCode": "resource function get bananas(int price) returns string {\n        if price > 10 {\n            if price > 100 {\n                int c = 12;\n                return \"expensive\";\n            } else {\n                int b = 2;\n                return \"moderate\";\n            }\n        }\n        return \"cheap\";\n    }"
