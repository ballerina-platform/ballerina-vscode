          "newText": "\nfinal ScopedToolKit scoped = check new (\"http://localhost:9101/mcp\", {name: \"Agent\", version: \"2.0.0\"}, httpConfig = {auth: {baseAuthUrl: \"http://localhost:9443\", clientId: \"agent-1\"}});"
