              "line": 31,
              "offset": 1
            }
          },
          "sourceCode": "public function main() returns error? {\n    typedesc<record {|anydata...;|}> rowType = Album;\n    Person first = check fetch(\"q1\", [Person, Order, Row]);\n    Albums albums = check fetch(\"q2\", [rowType, Album], targetType = Albums);\n    json raw = check fetch(\"q3\", [typeof first, Order]);\n    int count = check fetch(\"q4\", []);\n}"
        },
        "returning": false,
        "flags": 0
