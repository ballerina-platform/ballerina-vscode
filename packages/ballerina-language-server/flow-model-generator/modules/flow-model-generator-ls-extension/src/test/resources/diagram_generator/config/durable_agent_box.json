          "sourceCode": "function driveTravelAgent() returns error? {\n    string instanceId = check travelAgent.run(query = \"Plan a 3-day trip\", input = {city: \"Kandy\"});\n    string token = check travelAgent.sendData(instanceId = instanceId, eventName = \"hotelResults\", data = {ok: true});\n    string answer = check travelAgent.waitForDataResult(instanceId = instanceId, token = token);\n}"
        },
        "returning": false,
        "flags": 0
