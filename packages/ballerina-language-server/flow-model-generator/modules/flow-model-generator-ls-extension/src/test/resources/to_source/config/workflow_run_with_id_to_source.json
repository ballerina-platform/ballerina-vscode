    "metadata": {
      "label": "runWithId",
      "description": "Starts a workflow instance under an id the caller chooses — a business key such as an order\nnumber — so the id doubles as the correlation key. The policies say what happens when the id is\nalready held: `ifRunning = USE_EXISTING` makes a retried submit join the instance it already\nstarted instead of failing. The id must not be blank, longer than 255 bytes in UTF-8, or start with\na reserved prefix (`humantask-`, `reviewactivity-`, `childwf-`, `childagent-`).\n",
      "icon": "https://bcentral-packageicons.azureedge.net/images/ballerina_workflow_1.0.0.png"
    },
