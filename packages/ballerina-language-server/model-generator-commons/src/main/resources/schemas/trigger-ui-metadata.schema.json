{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wso2.github.io/ballerina-vscode/schemas/trigger-ui-metadata.schema.json",
  "title": "Ballerina Trigger UI Metadata v1.0",
  "description": "Canonical authoring format for sparse trigger UI overlays. Runtime schema models are derived from L1 metadata and semantic facts.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "v1.0"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "readOnlyMetadata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "initForm": {
      "$ref": "#/$defs/form"
    },
    "listeners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/listener"
      }
    },
    "serviceTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/serviceType"
      }
    },
    "importPrefix": {
      "type": "string"
    },
    "artifactInfo": {
      "type": "object"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "subLabel": {
          "type": "string"
        },
        "addLabel": {
          "type": "string"
        },
        "addDescription": {
          "type": "string"
        },
        "groupName": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "deprecated": {
          "type": "boolean"
        },
        "derived": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "triggerKind": {
          "type": "string"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "shortDisplayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "listenerKind": {
          "type": "string"
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\$"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "listener": {
              "type": "string"
            },
            "serviceType": {
              "type": "string"
            },
            "annotation": {
              "type": "string"
            },
            "handler": {
              "type": "string"
            },
            "param": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "construct": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            }
          }
        },
        "argument": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "originalName": {
              "type": "string"
            },
            "targetParam": {
              "type": "string"
            }
          }
        },
        "module": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "org": {
              "type": "string"
            },
            "packageName": {
              "type": "string"
            }
          }
        },
        "value": {},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultType": {
              "type": "string"
            },
            "boundType": {
              "type": "string"
            },
            "template": {},
            "typeConstraint": {
              "type": "string"
            },
            "modifier": {
              "type": "string"
            },
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "modifiers": {}
          }
        },
        "type": {
          "type": "string"
        },
        "argType": {
          "type": "string"
        },
        "originalName": {
          "type": "string"
        },
        "moduleName": {
          "type": "string"
        },
        "orgName": {
          "type": "string"
        },
        "packageName": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "defaultType": {
          "type": "string"
        },
        "boundType": {
          "type": "string"
        },
        "bindable": {
          "type": "boolean"
        },
        "bindingKind": {
          "type": "string"
        },
        "typeConstraint": {
          "type": "string"
        },
        "template": {},
        "modifier": {
          "type": "string"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetParam": {
          "type": "string"
        },
        "modifiers": {},
        "field": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "valueQualifier": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "variantLabel": {
          "type": "string"
        },
        "nameEditable": {
          "type": "boolean"
        },
        "bindingGroup": {
          "type": "string"
        },
        "driverDependency": {},
        "valueKind": {
          "type": "string"
        },
        "castType": {
          "type": "string"
        },
        "preserveValue": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        },
        "advanced": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "typeEditable": {
          "type": "boolean"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "target"
      ],
      "additionalProperties": true,
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "listener": {
      "$ref": "#/$defs/node"
    },
    "serviceType": {
      "$ref": "#/$defs/node"
    }
  }
}
