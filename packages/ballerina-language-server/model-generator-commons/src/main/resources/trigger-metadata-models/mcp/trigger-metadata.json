{
  "version": "v1.0",

  "listeners": [
    {
      "id": "$listener1",
      "doc": "MCP listener over the Streamable HTTP transport, wrapping an http:Listener and dispatching each tool call to the matching method.",
      "type": { "name": "StreamableHttpListener" },
      "services": ["$service", "$advancedService", "$streamableHttpService", "$streamableHttpAdvancedService"],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": true
    },
    {
      "id": "$listener2",
      "doc": "Renamed to make the transport explicit. Delegates every call to an internal StreamableHttpListener, so it accepts and dispatches the same service types the same way.",
      "deprecated": "Renamed to make the transport explicit. Use mcp:StreamableHttpListener instead.",
      "type": { "name": "Listener" },
      "services": ["$service", "$advancedService", "$streamableHttpService", "$streamableHttpAdvancedService"],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": true
    }
  ],

  "serviceTypes": [
    {
      "id": "$service",
      "doc": "An MCP server exposing each remote method as a tool, discovered automatically from its signature.",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "annotations": ["$serviceConfig"],
      "identifier": { "presence": "optional", "form": ["basePath"] },
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$service.tool",
            "name": "*",
            "kind": "remote",
            "addMode": "many",
            "doc": "One remote method per MCP tool. The method name becomes the tool name and its parameters become the tool's input schema, both discovered automatically, with no explicit registration.",
            "annotations": ["$tool"],
            "params": [
              {
                "id": "$service.tool.session",
                "name": "session",
                "doc": "The client session, when the server is running in a stateful session mode.",
                "type": { "name": "Session" },
                "presence": "optional"
              },
              {
                "id": "$service.tool.toolArg",
                "doc": "One tool argument. Repeat the slot once per argument the tool accepts; the user names each one and the names and types become the tool's input schema.",
                "type": { "name": "anydata", "builtin": true },
                "presence": "optional",
                "addMode": "many"
              }
            ],
            "returns": {
              "id": "$service.tool.returns",
              "type": [{ "name": "anydata", "builtin": true }, { "name": "error", "builtin": true }],
              "dataBinding": { "typedescs": [{ "constraint": { "name": "anydata", "builtin": true }, "shapes": [{ "form": "bare" }] }] }
            }
          }
        ]
      }
    },
    {
      "id": "$advancedService",
      "doc": "The advanced MCP server form, where tool listing and invocation are handled explicitly rather than discovered automatically.",
      "type": { "name": "AdvancedService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "annotations": ["$serviceConfig"],
      "identifier": { "presence": "optional", "form": ["basePath"] },
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$streamableHttpService",
      "doc": "An MCP server exposing each remote method as a tool over the streamable HTTP transport, discovered automatically from its signature.",
      "type": { "name": "StreamableHttpService" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "annotations": ["$streamableHttpServiceConfig"],
      "identifier": { "presence": "optional", "form": ["basePath"] },
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$streamableHttpService.tool",
            "name": "*",
            "kind": "remote",
            "addMode": "many",
            "doc": "One remote method per MCP tool, served over the streamable HTTP transport. Tool name and input schema are discovered from the method signature.",
            "annotations": ["$tool"],
            "params": [
              {
                "id": "$streamableHttpService.tool.session",
                "name": "session",
                "doc": "The client session, when the server is running in a stateful session mode.",
                "type": { "name": "Session" },
                "presence": "optional"
              },
              {
                "id": "$streamableHttpService.tool.toolArg",
                "doc": "One tool argument. Repeat the slot once per argument the tool accepts; the user names each one and the names and types become the tool's input schema.",
                "type": { "name": "anydata", "builtin": true },
                "presence": "optional",
                "addMode": "many"
              },
              {
                "id": "$streamableHttpService.tool.headerParam",
                "doc": "One HTTP request header. Repeat the slot once per header the tool reads; the user names each one.",
                "type": [{ "name": "string", "builtin": true }, { "name": "int", "builtin": true }, { "name": "boolean", "builtin": true }, { "name": "decimal", "builtin": true }, { "name": "float", "builtin": true }],
                "presence": "optional",
                "addMode": "many",
                "annotations": ["$httpHeader"]
              },
              {
                "id": "$streamableHttpService.tool.headers",
                "name": "headers",
                "doc": "Read-only access to the inbound HTTP request headers.",
                "type": {
                  "name": "Headers",
                  "packageInfo": { "org": "ballerina", "packageName": "http", "moduleName": "http", "version": "2.16.5" }
                },
                "presence": "optional"
              },
              {
                "id": "$streamableHttpService.tool.request",
                "name": "request",
                "doc": "The raw inbound HTTP request, for anything the bound parameters do not expose.",
                "type": {
                  "name": "Request",
                  "packageInfo": { "org": "ballerina", "packageName": "http", "moduleName": "http", "version": "2.16.5" }
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$streamableHttpService.tool.returns",
              "type": [{ "name": "anydata", "builtin": true }, { "name": "error", "builtin": true }],
              "dataBinding": { "typedescs": [{ "constraint": { "name": "anydata", "builtin": true }, "shapes": [{ "form": "bare" }] }] }
            }
          }
        ]
      }
    },
    {
      "id": "$streamableHttpAdvancedService",
      "doc": "The advanced MCP server form over streamable HTTP, where tool listing and invocation are handled explicitly rather than discovered automatically.",
      "type": { "name": "StreamableHttpAdvancedService" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "annotations": ["$streamableHttpServiceConfig"],
      "identifier": { "presence": "optional", "form": ["basePath"] },
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$streamableHttpAdvancedService.onListTools",
            "name": "onListTools",
            "kind": "remote",
            "doc": "Invoked when a client asks for this server's tool catalogue. Use this when the catalogue is computed at runtime rather than discovered from remote methods.",
            "presence": "required",
            "params": [
              {
                "id": "$streamableHttpAdvancedService.onListTools.headerParam",
                "doc": "One HTTP request header. Repeat the slot once per header the tool reads; the user names each one.",
                "type": [{ "name": "string", "builtin": true }, { "name": "int", "builtin": true }, { "name": "boolean", "builtin": true }, { "name": "decimal", "builtin": true }, { "name": "float", "builtin": true }],
                "presence": "optional",
                "addMode": "many",
                "annotations": ["$httpHeader"]
              },
              {
                "id": "$streamableHttpAdvancedService.onListTools.headers",
                "name": "headers",
                "doc": "Read-only access to the inbound HTTP request headers.",
                "type": {
                  "name": "Headers",
                  "packageInfo": { "org": "ballerina", "packageName": "http", "moduleName": "http", "version": "2.16.5" }
                },
                "presence": "optional"
              },
              {
                "id": "$streamableHttpAdvancedService.onListTools.request",
                "name": "request",
                "doc": "The raw inbound HTTP request, for anything the bound parameters do not expose.",
                "type": {
                  "name": "Request",
                  "packageInfo": { "org": "ballerina", "packageName": "http", "moduleName": "http", "version": "2.16.5" }
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$streamableHttpAdvancedService.onListTools.returns",
              "type": [{ "name": "ListToolsResult" }, { "name": "ServerError" }]
            }
          },
          {
            "id": "$streamableHttpAdvancedService.onCallTool",
            "name": "onCallTool",
            "kind": "remote",
            "doc": "Invoked when a client invokes a tool by name. Dispatching to the right implementation and binding the arguments are the service's own responsibility here, unlike the automatic form.",
            "presence": "required",
            "params": [
              {
                "id": "$streamableHttpAdvancedService.onCallTool.params",
                "name": "params",
                "doc": "The tool name and the arguments the client supplied for it.",
                "type": { "name": "CallToolParams" },
                "presence": "required"
              },
              {
                "id": "$streamableHttpAdvancedService.onCallTool.session",
                "name": "session",
                "doc": "The client session, when the server is running in a stateful session mode.",
                "type": { "name": "Session" },
                "presence": "optional"
              },
              {
                "id": "$streamableHttpAdvancedService.onCallTool.headerParam",
                "doc": "One HTTP request header. Repeat the slot once per header the tool reads; the user names each one.",
                "type": [{ "name": "string", "builtin": true }, { "name": "int", "builtin": true }, { "name": "boolean", "builtin": true }, { "name": "decimal", "builtin": true }, { "name": "float", "builtin": true }],
                "presence": "optional",
                "addMode": "many",
                "annotations": ["$httpHeader"]
              },
              {
                "id": "$streamableHttpAdvancedService.onCallTool.headers",
                "name": "headers",
                "doc": "Read-only access to the inbound HTTP request headers.",
                "type": {
                  "name": "Headers",
                  "packageInfo": { "org": "ballerina", "packageName": "http", "moduleName": "http", "version": "2.16.5" }
                },
                "presence": "optional"
              },
              {
                "id": "$streamableHttpAdvancedService.onCallTool.request",
                "name": "request",
                "doc": "The raw inbound HTTP request, for anything the bound parameters do not expose.",
                "type": {
                  "name": "Request",
                  "packageInfo": { "org": "ballerina", "packageName": "http", "moduleName": "http", "version": "2.16.5" }
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$streamableHttpAdvancedService.onCallTool.returns",
              "type": [{ "name": "CallToolResult" }, { "name": "ServerError" }]
            }
          }
        ]
      }
    }
  ],

  "annotations": [
    { "id": "$serviceConfig", "type": { "name": "ServiceConfig" }, "attachPoint": "service", "presence": "optional" },
    {
      "id": "$streamableHttpServiceConfig",
      "type": { "name": "StreamableHttpServiceConfig" },
      "attachPoint": "service",
      "presence": "optional"
    },
    { "id": "$tool", "type": { "name": "Tool" }, "attachPoint": "function", "presence": "optional" },
    {
      "id": "$httpHeader",
      "type": {
        "name": "Header",
        "packageInfo": { "org": "ballerina", "packageName": "http", "moduleName": "http", "version": "2.16.5" }
      },
      "attachPoint": "parameter",
      "presence": "optional"
    }
  ]
}
