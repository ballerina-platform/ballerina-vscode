{
  "version": "v1.0",
  "metadata": {
    "kind": "listener"
  },
  "trigger": {
    "displayName": "TCP"
  },
  "listeners": [
    {
      "target": "$listener"
    }
  ],
  "serviceTypes": [
    {
      "target": "$service",
      "handlers": [
        {
          "target": "$service.onConnect",
          "parameters": [
            {
              "target": "$service.onConnect.caller"
            }
          ],
          "returnType": {
            "target": "$service.onConnect.returns"
          }
        }
      ]
    },
    {
      "target": "$connectionService",
      "handlers": [
        {
          "target": "$connectionService.onBytes",
          "parameters": [
            {
              "target": "$connectionService.onBytes.data"
            }
          ],
          "returnType": {
            "target": "$connectionService.onBytes.returns"
          }
        },
        {
          "target": "$connectionService.onError",
          "parameters": [
            {
              "target": "$connectionService.onError.err"
            }
          ],
          "returnType": {
            "target": "$connectionService.onError.returns"
          }
        },
        {
          "target": "$connectionService.onClose",
          "returnType": {
            "target": "$connectionService.onClose.returns"
          }
        }
      ]
    }
  ],
  "artifactInfo": {
    "displayLabel": "TCP Service",
    "icon": {
      "lightPath": "icons/light.svg",
      "darkPath": "icons/dark.svg"
    }
  }
}
