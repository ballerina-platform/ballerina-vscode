{
  "version": "v1.0",
  "listeners": [
    {
      "id": "$listener",
      "doc": "Webhook listener that dispatches each inbound WhatsApp Business Account notification to the attached service.",
      "type": {
        "name": "Listener"
      },
      "services": [
        "$service"
      ],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": true
    }
  ],
  "serviceTypes": [
    {
      "id": "$service",
      "doc": "Receives WhatsApp Business Account webhook notifications: messages, status updates, and account/template lifecycle changes.",
      "type": {
        "name": "WhatsAppService"
      },
      "concrete": false,
      "multipleListenersAllowed": true,
      "identifier": {
        "presence": "optional",
        "form": [
          "basePath"
        ]
      },
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$service.onMessages",
            "name": "onMessages",
            "kind": "remote",
            "doc": "Invoked once per messages webhook notification: either a batch of inbound messages or a batch of outbound status updates. Meta always sends these as two mutually exclusive shapes under this one field, never both together; narrow with `notification is Messages` / `notification is MessageStatuses`.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onMessages.notification",
                "name": "notification",
                "doc": "Either the inbound messages batch or the status updates batch delivered under this notification.",
                "type": {
                  "name": "MessagesNotification"
                },
                "presence": "required"
              },
              {
                "id": "$service.onMessages.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onMessages.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onAccountReviewUpdate",
            "name": "onAccountReviewUpdate",
            "kind": "remote",
            "doc": "Invoked when a WhatsApp Business Account's review decision changes.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onAccountReviewUpdate.update",
                "name": "update",
                "doc": "The account review decision.",
                "type": {
                  "name": "AccountReviewUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onAccountReviewUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onAccountReviewUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onAccountUpdate",
            "name": "onAccountUpdate",
            "kind": "remote",
            "doc": "Invoked on account-lifecycle and compliance changes: verification, violations, partner changes, pricing-tier updates, restrictions, or disconnection.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onAccountUpdate.update",
                "name": "update",
                "doc": "The account-lifecycle or compliance change.",
                "type": {
                  "name": "AccountUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onAccountUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onAccountUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onBusinessCapabilityUpdate",
            "name": "onBusinessCapabilityUpdate",
            "kind": "remote",
            "doc": "Invoked when a WhatsApp Business Account's messaging or phone-number capability limits change.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onBusinessCapabilityUpdate.update",
                "name": "update",
                "doc": "The updated capability limits.",
                "type": {
                  "name": "BusinessCapabilityUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onBusinessCapabilityUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onBusinessCapabilityUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onMessageTemplateQualityUpdate",
            "name": "onMessageTemplateQualityUpdate",
            "kind": "remote",
            "doc": "Invoked when a message template's quality score changes.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onMessageTemplateQualityUpdate.update",
                "name": "update",
                "doc": "The template's previous and new quality score.",
                "type": {
                  "name": "MessageTemplateQualityUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onMessageTemplateQualityUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onMessageTemplateQualityUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onMessageTemplateStatusUpdate",
            "name": "onMessageTemplateStatusUpdate",
            "kind": "remote",
            "doc": "Invoked when a message template's status changes, for example approved, rejected, disabled, archived, or unarchived.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onMessageTemplateStatusUpdate.update",
                "name": "update",
                "doc": "The template's status change.",
                "type": {
                  "name": "MessageTemplateStatusUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onMessageTemplateStatusUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onMessageTemplateStatusUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onPhoneNumberNameUpdate",
            "name": "onPhoneNumberNameUpdate",
            "kind": "remote",
            "doc": "Invoked when a business phone number's display-name review outcome is available.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onPhoneNumberNameUpdate.update",
                "name": "update",
                "doc": "The display-name review outcome.",
                "type": {
                  "name": "PhoneNumberNameUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onPhoneNumberNameUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onPhoneNumberNameUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onPhoneNumberQualityUpdate",
            "name": "onPhoneNumberQualityUpdate",
            "kind": "remote",
            "doc": "Invoked when a business phone number's messaging throughput or quality tier changes.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onPhoneNumberQualityUpdate.update",
                "name": "update",
                "doc": "The throughput or quality tier change.",
                "type": {
                  "name": "PhoneNumberQualityUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onPhoneNumberQualityUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onPhoneNumberQualityUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onSecurity",
            "name": "onSecurity",
            "kind": "remote",
            "doc": "Invoked on two-step-verification PIN changes and reset requests for a business phone number.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onSecurity.security",
                "name": "security",
                "doc": "The PIN change or reset event.",
                "type": {
                  "name": "Security"
                },
                "presence": "required"
              },
              {
                "id": "$service.onSecurity.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onSecurity.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onTemplateCategoryUpdate",
            "name": "onTemplateCategoryUpdate",
            "kind": "remote",
            "doc": "Invoked when a message template's category changes, or is about to change (Meta's 24-hour advance notice).",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onTemplateCategoryUpdate.update",
                "name": "update",
                "doc": "The template category change, imminent or completed.",
                "type": {
                  "name": "TemplateCategoryUpdate"
                },
                "presence": "required"
              },
              {
                "id": "$service.onTemplateCategoryUpdate.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onTemplateCategoryUpdate.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onError",
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when any of the ten handlers above returns an error while being dispatched for an incoming notification. The notification has already been acknowledged to Meta by this point, so this is the only way to react to a handler failure other than logging, which always happens regardless of whether onError is declared.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onError.handlerError",
                "name": "handlerError",
                "doc": "The error the failed handler returned, the webhook field being dispatched, and the raw payload that was being dispatched.",
                "type": {
                  "name": "HandlerError"
                },
                "presence": "required"
              },
              {
                "id": "$service.onError.caller",
                "name": "caller",
                "doc": "WhatsApp caller used to manually acknowledge notifications.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onError.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          }
        ]
      },
      "rules": [
        {
          "id": "$atLeastOneWebhookHandler",
          "rule": "structure.atLeastOne",
          "message": "A WhatsAppService must declare at least one of the ten webhook field handlers, otherwise nothing is ever dispatched. onError alone does not count.",
          "subjects": [
            {
              "kind": "handler",
              "id": "$service.onMessages"
            },
            {
              "kind": "handler",
              "id": "$service.onAccountReviewUpdate"
            },
            {
              "kind": "handler",
              "id": "$service.onAccountUpdate"
            },
            {
              "kind": "handler",
              "id": "$service.onBusinessCapabilityUpdate"
            },
            {
              "kind": "handler",
              "id": "$service.onMessageTemplateQualityUpdate"
            },
            {
              "kind": "handler",
              "id": "$service.onMessageTemplateStatusUpdate"
            },
            {
              "kind": "handler",
              "id": "$service.onPhoneNumberNameUpdate"
            },
            {
              "kind": "handler",
              "id": "$service.onPhoneNumberQualityUpdate"
            },
            {
              "kind": "handler",
              "id": "$service.onSecurity"
            },
            {
              "kind": "handler",
              "id": "$service.onTemplateCategoryUpdate"
            }
          ]
        }
      ],
      "annotations": [
        "$serviceConfig"
      ]
    }
  ],
  "annotations": [
    {
      "id": "$serviceConfig",
      "type": {
        "name": "WhatsAppServiceConfig"
      },
      "attachPoint": "service",
      "presence": "optional"
    }
  ]
}
