    {
      "target": "$rfcService",
      "metadata": {
        "label": "SAP JCo RFC Service",
        "description": "Handles inbound RFC calls from an SAP system. SAP invokes the service as if it were a registered RFC function module."
      },
      "handlers": [
        {
          "target": "$rfcService.onCall",
          "metadata": {
            "label": "On Call",
            "description": "Invoked synchronously when SAP calls a function module registered on this server."
          },
          "state": {
            "editable": false,
            "enabled": true,
            "optional": false
          },
