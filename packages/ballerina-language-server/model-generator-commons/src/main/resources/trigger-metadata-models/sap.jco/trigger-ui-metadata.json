  "serviceTypes": [
    {
      "target": "$idocService",
      "metadata": {
        "label": "SAP JCo IDoc Service",
        "description": "Handles IDocs pushed from an SAP system."
      },
      "handlers": [
        {
          "target": "$idocService.onReceive",
          "metadata": {
            "label": "On Receive",
            "description": "Invoked when an IDoc is received from the SAP system."
          },
          "state": {
            "editable": false,
            "enabled": true,
            "optional": false
          },
          "parameters": [
            {
              "target": "$idocService.onReceive.iDoc",
              "metadata": {
                "label": "IDoc",
                "description": "The received IDoc, as XML."
              },
              "state": {
                "editable": false,
                "enabled": true,
                "optional": false,
                "advanced": false,
                "hidden": false
              },
              "fields": [
                {
                  "target": {
                    "kind": "recordField",
                    "owner": "iDoc.parameter",
                    "path": "type"
                  },
                  "metadata": {
                    "label": "Parameter Type",
                    "description": "The type of the parameter"
                  },
                  "state": {
                    "editable": false,
                    "enabled": true,
                    "optional": true,
                    "advanced": false
                  },
                  "key": "type",
                  "placeholder": "xml",
                  "default": "xml"
                },
                {
                  "target": {
                    "kind": "recordField",
                    "owner": "iDoc.parameter",
                    "path": "name"
                  },
                  "metadata": {
                    "label": "iDoc"
                  },
                  "state": {
                    "editable": false,
                    "enabled": true,
                    "optional": false,
                    "advanced": false
                  },
                  "key": "name",
                  "placeholder": "iDoc",
                  "default": "iDoc"
                }
              ],
              "source": {
                "construct": {
                  "kind": "FUNCTION_PARAM"
                }
              }
            }
          ],
          "returnType": {
            "target": "$idocService.onReceive.returns",
            "metadata": {
              "label": "Return Type",
              "description": "The return type of the function."
            },
            "state": {
              "editable": false,
              "enabled": true,
              "optional": true
            },
            "source": {
              "construct": {
                "kind": "FUNCTION_RETURN"
              }
            }
          },
          "source": {
            "construct": {
              "kind": "FUNCTION"
            },
            "argument": {
              "originalName": "onReceive"
            },
            "module": {
              "name": "jco"
            }
          },
          "nameEditable": false,
          "repeatable": "FALSE",
          "canAddParameters": false,
          "documentation": {
            "default": "Invoked when an IDoc is received from the SAP system."
          }
        },
        {
          "target": "$idocService.onError",
          "metadata": {
            "label": "On Error",
            "description": "Invoked when a framework-level error occurs while the listener is handling a request (e.g. JCo gateway/server errors, connectivity problems, IDoc parsing failures)."
          },
          "state": {
            "editable": false,
            "enabled": true,
            "optional": false
          },
          "parameters": [
            {
              "target": "$idocService.onError.err",
              "metadata": {
                "label": "Error",
                "description": "The framework-level error that occurred."
              },
              "state": {
                "editable": false,
                "enabled": true,
                "optional": false,
                "advanced": false,
                "hidden": false
              },
              "fields": [
                {
                  "target": {
                    "kind": "recordField",
                    "owner": "err.parameter",
                    "path": "type"
                  },
                  "metadata": {
                    "label": "Parameter Type",
                    "description": "The type of the parameter"
                  },
                  "state": {
                    "editable": false,
                    "enabled": true,
                    "optional": true,
                    "advanced": false
                  },
                  "key": "type",
                  "placeholder": "error",
                  "default": "error"
                },
                {
                  "target": {
                    "kind": "recordField",
                    "owner": "err.parameter",
                    "path": "name"
                  },
                  "metadata": {
                    "label": "err"
                  },
                  "state": {
                    "editable": false,
                    "enabled": true,
                    "optional": false,
                    "advanced": false
                  },
                  "key": "name",
                  "placeholder": "err",
                  "default": "err"
                }
              ],
              "source": {
                "construct": {
                  "kind": "FUNCTION_PARAM"
                }
              }
            }
          ],
          "returnType": {
            "target": "$idocService.onError.returns",
            "metadata": {
              "label": "Return Type",
              "description": "The return type of the function."
            },
            "state": {
              "editable": false,
              "enabled": true,
              "optional": true
            },
            "source": {
              "construct": {
                "kind": "FUNCTION_RETURN"
              }
            }
          },
          "source": {
            "construct": {
              "kind": "FUNCTION"
            },
            "argument": {
              "originalName": "onError"
            },
            "module": {
              "name": "jco"
            }
          },
          "nameEditable": false,
          "repeatable": "FALSE",
          "canAddParameters": false,
          "documentation": {
            "default": "Invoked when a framework-level error occurs while the listener is handling a request. This covers JCo gateway and server errors surfaced asynchronously by the JCo runtime (connection retries, registration failures) and pre-dispatch failures such as IDoc rendering or parsing. It is not invoked for errors raised by the IDoc receive handler itself - IDoc delivery is fire-and-forget and per-call errors are logged instead."
          }
        }
      ],
