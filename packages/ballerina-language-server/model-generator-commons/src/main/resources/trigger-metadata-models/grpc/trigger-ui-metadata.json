{
  "version": "v1.0",
  "metadata": {
    "kind": "listener"
  },
  "trigger": {
    "displayName": "gRPC"
  },
  "listeners": [
    {
      "target": "$listener"
    }
  ],
  "serviceTypes": [
    {
      "target": "$service",
      "handlers": [
        {
          "target": "$service.unary",
          "parameters": [
            {
              "target": "$service.unary.caller"
            },
            {
              "target": "$service.unary.request"
            }
          ],
          "returnType": {
            "target": "$service.unary.returns"
          }
        },
        {
          "target": "$service.serverStreaming",
          "parameters": [
            {
              "target": "$service.serverStreaming.caller"
            },
            {
              "target": "$service.serverStreaming.request"
            }
          ],
          "returnType": {
            "target": "$service.serverStreaming.returns"
          }
        },
        {
          "target": "$service.clientStreaming",
          "parameters": [
            {
              "target": "$service.clientStreaming.caller"
            },
            {
              "target": "$service.clientStreaming.clientStream"
            }
          ],
          "returnType": {
            "target": "$service.clientStreaming.returns"
          }
        },
        {
          "target": "$service.bidiStreaming",
          "parameters": [
            {
              "target": "$service.bidiStreaming.caller"
            },
            {
              "target": "$service.bidiStreaming.clientStream"
            }
          ],
          "returnType": {
            "target": "$service.bidiStreaming.returns"
          }
        }
      ]
    }
  ],
  "artifactInfo": {
    "displayLabel": "gRPC Service",
    "icon": {
      "lightPath": "icons/light.svg",
      "darkPath": "icons/dark.svg"
    }
  }
}
