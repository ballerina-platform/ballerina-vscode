{
  "version": "v1.0",
  "metadata": {
    "kind": "listener"
  },
  "trigger": {
    "displayName": "WebSocket"
  },
  "listeners": [
    {
      "target": "$listener"
    }
  ],
  "serviceTypes": [
    {
      "target": "$upgradeService",
      "handlers": [
        {
          "target": "$upgradeService.get",
          "parameters": [
            {
              "target": "$upgradeService.get.request"
            }
          ],
          "returnType": {
            "target": "$upgradeService.get.returns"
          }
        }
      ]
    },
    {
      "target": "$service",
      "handlers": [
        {
          "target": "$service.onOpen",
          "parameters": [
            {
              "target": "$service.onOpen.caller"
            }
          ],
          "returnType": {
            "target": "$service.onOpen.returns"
          }
        },
        {
          "target": "$service.onMessage",
          "parameters": [
            {
              "target": "$service.onMessage.caller"
            },
            {
              "target": "$service.onMessage.data"
            }
          ],
          "returnType": {
            "target": "$service.onMessage.returns"
          }
        },
        {
          "target": "$service.onTextMessage",
          "parameters": [
            {
              "target": "$service.onTextMessage.caller"
            },
            {
              "target": "$service.onTextMessage.text"
            }
          ],
          "returnType": {
            "target": "$service.onTextMessage.returns"
          }
        },
        {
          "target": "$service.onBinaryMessage",
          "parameters": [
            {
              "target": "$service.onBinaryMessage.caller"
            },
            {
              "target": "$service.onBinaryMessage.data"
            }
          ],
          "returnType": {
            "target": "$service.onBinaryMessage.returns"
          }
        },
        {
          "target": "$service.onPing",
          "parameters": [
            {
              "target": "$service.onPing.caller"
            },
            {
              "target": "$service.onPing.data"
            }
          ],
          "returnType": {
            "target": "$service.onPing.returns"
          }
        },
        {
          "target": "$service.onPong",
          "parameters": [
            {
              "target": "$service.onPong.caller"
            },
            {
              "target": "$service.onPong.data"
            }
          ],
          "returnType": {
            "target": "$service.onPong.returns"
          }
        },
        {
          "target": "$service.onIdleTimeout",
          "parameters": [
            {
              "target": "$service.onIdleTimeout.caller"
            }
          ],
          "returnType": {
            "target": "$service.onIdleTimeout.returns"
          }
        },
        {
          "target": "$service.onClose",
          "parameters": [
            {
              "target": "$service.onClose.caller"
            },
            {
              "target": "$service.onClose.statusCode"
            },
            {
              "target": "$service.onClose.reason"
            }
          ],
          "returnType": {
            "target": "$service.onClose.returns"
          }
        },
        {
          "target": "$service.onError",
          "parameters": [
            {
              "target": "$service.onError.caller"
            },
            {
              "target": "$service.onError.err"
            }
          ],
          "returnType": {
            "target": "$service.onError.returns"
          }
        },
        {
          "target": "$service.dispatched",
          "parameters": [
            {
              "target": "$service.dispatched.caller"
            },
            {
              "target": "$service.dispatched.message"
            }
          ],
          "returnType": {
            "target": "$service.dispatched.returns"
          }
        },
        {
          "target": "$service.dispatchedError",
          "parameters": [
            {
              "target": "$service.dispatchedError.caller"
            },
            {
              "target": "$service.dispatchedError.err"
            }
          ],
          "returnType": {
            "target": "$service.dispatchedError.returns"
          }
        }
      ]
    }
  ],
  "artifactInfo": {
    "displayLabel": "WebSocket Service",
    "icon": {
      "lightPath": "icons/light.svg",
      "darkPath": "icons/dark.svg"
    }
  }
}
