{
  "version": "v1.0",
  "listeners": [
    {
      "id": "$listener",
      "doc": "Polls the configured Azure Files share on its configured interval and dispatches each detected file to the attached service.",
      "type": {
        "name": "Listener"
      },
      "services": [
        "$service"
      ],
      "multipleServicesAllowed": true
    }
  ],
  "serviceTypes": [
    {
      "id": "$service",
      "doc": "Receives files detected on the watched Azure Files share, typed by extension, with an untyped fallback and an error handler.",
      "type": {
        "name": "Service"
      },
      "concrete": false,
      "multipleListenersAllowed": false,
      "annotations": [
        "$serviceConfig"
      ],
      "identifier": {
        "presence": "required",
        "form": [
          "basePath"
        ]
      },
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$service.onFileCsv",
            "name": "onFileCsv",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .csv, or that matches the pattern set on @files:FunctionConfig. Declaring a stream parameter reads the file in chunks instead of loading it into memory. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onFileCsv.content",
                "name": "content",
                "doc": "The parsed rows, as batched or streamed string rows or records; the field names of a record row come from the header row. Binding is strict.",
                "type": [
                  {
                    "shape": "array",
                    "elementType": {
                      "shape": "array",
                      "elementType": {
                        "name": "string",
                        "builtin": true
                      }
                    }
                  },
                  {
                    "shape": "array",
                    "elementType": {
                      "name": "record {}",
                      "builtin": true
                    }
                  },
                  {
                    "shape": "stream",
                    "elementType": {
                      "shape": "array",
                      "elementType": {
                        "name": "string",
                        "builtin": true
                      }
                    },
                    "completionType": [
                      {
                        "name": "error",
                        "builtin": true
                      },
                      {
                        "name": "()",
                        "builtin": true
                      }
                    ]
                  },
                  {
                    "shape": "stream",
                    "elementType": {
                      "name": "record {}",
                      "builtin": true
                    },
                    "completionType": [
                      {
                        "name": "error",
                        "builtin": true
                      },
                      {
                        "name": "()",
                        "builtin": true
                      }
                    ]
                  }
                ],
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": {
                        "shape": "array",
                        "elementType": {
                          "name": "string",
                          "builtin": true
                        }
                      },
                      "shapes": [
                        {
                          "form": "array",
                          "element": "bare"
                        },
                        {
                          "form": "stream",
                          "element": "bare",
                          "completionType": [
                            {
                              "name": "error",
                              "builtin": true
                            },
                            {
                              "name": "()",
                              "builtin": true
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "constraint": {
                        "name": "record {}",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "array",
                          "element": "bare"
                        },
                        {
                          "form": "stream",
                          "element": "bare",
                          "completionType": [
                            {
                              "name": "error",
                              "builtin": true
                            },
                            {
                              "name": "()",
                              "builtin": true
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "$service.onFileCsv.fileInfo",
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": {
                  "name": "FileInfo"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onFileCsv.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onFileCsv.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onFileJson",
            "name": "onFileJson",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .json, or that matches the pattern set on @files:FunctionConfig. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onFileJson.content",
                "name": "content",
                "doc": "The parsed content, bind a record type to project it. Binding is strict: the content must match the target type exactly.",
                "type": {
                  "name": "json",
                  "builtin": true
                },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": {
                        "name": "json",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    },
                    {
                      "constraint": {
                        "name": "record {}",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "$service.onFileJson.fileInfo",
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": {
                  "name": "FileInfo"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onFileJson.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onFileJson.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onFileXml",
            "name": "onFileXml",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .xml, or that matches the pattern set on @files:FunctionConfig. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onFileXml.content",
                "name": "content",
                "doc": "The parsed content, bind a record type to project it from the document. Binding is strict.",
                "type": {
                  "name": "xml",
                  "builtin": true
                },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": {
                        "name": "xml",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    },
                    {
                      "constraint": {
                        "name": "record {}",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "$service.onFileXml.fileInfo",
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": {
                  "name": "FileInfo"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onFileXml.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onFileXml.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onFileText",
            "name": "onFileText",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .txt, or that matches the pattern set on @files:FunctionConfig. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onFileText.content",
                "name": "content",
                "doc": "The file's text content, decoded as UTF-8.",
                "type": {
                  "name": "string",
                  "builtin": true
                },
                "presence": "required"
              },
              {
                "id": "$service.onFileText.fileInfo",
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": {
                  "name": "FileInfo"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onFileText.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onFileText.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onFile",
            "name": "onFile",
            "kind": "remote",
            "doc": "Invoked for any file no typed handler matched, and as the fallback when no typed handler is declared. Content arrives as raw bytes.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onFile.content",
                "name": "content",
                "doc": "The file's bytes. Declare the stream form to read large files in chunks rather than loading them into memory.",
                "type": [
                  {
                    "shape": "array",
                    "elementType": {
                      "name": "byte",
                      "builtin": true
                    }
                  },
                  {
                    "shape": "stream",
                    "elementType": {
                      "shape": "array",
                      "elementType": {
                        "name": "byte",
                        "builtin": true
                      }
                    },
                    "completionType": [
                      {
                        "name": "error",
                        "builtin": true
                      },
                      {
                        "name": "()",
                        "builtin": true
                      }
                    ]
                  }
                ],
                "presence": "required"
              },
              {
                "id": "$service.onFile.fileInfo",
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": {
                  "name": "FileInfo"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onFile.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onFile.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onError",
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when a poll, download, or content-binding failure occurs. Without it, the failure is logged and polling continues.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onError.err",
                "name": "err",
                "doc": "The failure that interrupted processing.",
                "type": {
                  "name": "Error"
                },
                "presence": "required"
              },
              {
                "id": "$service.onError.caller",
                "name": "caller",
                "doc": "The share connection, for acting on the share while handling the failure.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onError.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          }
        ]
      },
      "rules": [
        {
          "id": "$atLeastOneFileHandler",
          "rule": "structure.atLeastOne",
          "message": "An Azure Files service must declare at least one file handler. onError alone never receives a file, so the service would do nothing.",
          "subjects": [
            {
              "kind": "handler",
              "id": "$service.onFileText"
            },
            {
              "kind": "handler",
              "id": "$service.onFileJson"
            },
            {
              "kind": "handler",
              "id": "$service.onFileXml"
            },
            {
              "kind": "handler",
              "id": "$service.onFileCsv"
            },
            {
              "kind": "handler",
              "id": "$service.onFile"
            }
          ]
        }
      ]
    }
  ],
  "annotations": [
    {
      "id": "$serviceConfig",
      "type": {
        "name": "ServiceConfig"
      },
      "attachPoint": "service",
      "presence": "optional"
    },
    {
      "id": "$functionConfig",
      "type": {
        "name": "FunctionConfig"
      },
      "attachPoint": "function",
      "presence": "optional"
    }
  ]
}
