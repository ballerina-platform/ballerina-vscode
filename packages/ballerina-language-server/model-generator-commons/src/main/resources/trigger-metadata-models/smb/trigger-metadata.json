{
  "version": "v1.0",

  "listeners": [
    {
      "id": "$listener",
      "doc": "Polls the watched directory on the SMB share on its configured interval and dispatches each file event to the attached service.",
      "type": { "name": "Listener" },
      "services": ["$service"],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": true
    }
  ],

  "serviceTypes": [
    {
      "id": "$service",
      "doc": "Consumes files found in the watched directory on the SMB share, dispatching each to the handler matching its content type.",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "annotations": ["$serviceConfig"],
      "identifier": { "presence": "optional", "form": ["basePath"] },
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$service.onFileText",
            "name": "onFileText",
            "kind": "remote",
            "doc": "Invoked for each .txt, .log, or .md file found in the watched directory. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "id": "$service.onFileText.content",
                "name": "content",
                "doc": "The file's text content.",
                "type": { "name": "string", "builtin": true },
                "presence": "required"
              },
              {
                "id": "$service.onFileText.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              },
              {
                "id": "$service.onFileText.fileInfo",
                "name": "fileInfo",
                "doc": "The file's name, path, size, timestamps, and attributes.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": { "id": "$service.onFileText.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          },
          {
            "id": "$service.onFileJson",
            "name": "onFileJson",
            "kind": "remote",
            "doc": "Invoked for each .json file found in the watched directory. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "id": "$service.onFileJson.content",
                "name": "content",
                "doc": "The parsed content, bind a record type to project it, see the jsonContent data-binding rule.",
                "type": { "name": "json", "builtin": true },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    { "constraint": { "name": "json", "builtin": true }, "shapes": [{ "form": "bare" }] },
                    { "constraint": { "name": "record {}", "builtin": true }, "shapes": [{ "form": "bare" }] }
                  ]
                }
              },
              {
                "id": "$service.onFileJson.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              },
              {
                "id": "$service.onFileJson.fileInfo",
                "name": "fileInfo",
                "doc": "The file's name, path, size, timestamps, and attributes.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": { "id": "$service.onFileJson.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          },
          {
            "id": "$service.onFileXml",
            "name": "onFileXml",
            "kind": "remote",
            "doc": "Invoked for each .xml file found in the watched directory. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "id": "$service.onFileXml.content",
                "name": "content",
                "doc": "The parsed content, bind a record type to project it, see the xmlContent data-binding rule.",
                "type": { "name": "xml", "builtin": true },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    { "constraint": { "name": "xml", "builtin": true }, "shapes": [{ "form": "bare" }] },
                    { "constraint": { "name": "record {}", "builtin": true }, "shapes": [{ "form": "bare" }] }
                  ]
                }
              },
              {
                "id": "$service.onFileXml.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              },
              {
                "id": "$service.onFileXml.fileInfo",
                "name": "fileInfo",
                "doc": "The file's name, path, size, timestamps, and attributes.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": { "id": "$service.onFileXml.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          },
          {
            "id": "$service.onFileCsv",
            "name": "onFileCsv",
            "kind": "remote",
            "doc": "Invoked for each .csv file found in the watched directory. Declaring a stream parameter reads the file in chunks instead of loading it into memory.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "id": "$service.onFileCsv.content",
                "name": "content",
                "doc": "The parsed rows, see the csvContent data-binding rule for the batched and streamed forms.",
                "type": [
                  { "shape": "array", "elementType": { "shape": "array", "elementType": { "name": "string", "builtin": true } } },
                  { "shape": "array", "elementType": { "name": "record {}", "builtin": true } },
                  {
                    "shape": "stream",
                    "elementType": { "shape": "array", "elementType": { "name": "string", "builtin": true } },
                    "completionType": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }]
                  },
                  {
                    "shape": "stream",
                    "elementType": { "name": "record {}", "builtin": true },
                    "completionType": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }]
                  }
                ],
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": { "shape": "array", "elementType": { "name": "string", "builtin": true } },
                      "shapes": [
                        { "form": "array", "element": "bare" },
                        { "form": "stream", "element": "bare", "completionType": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
                      ]
                    },
                    {
                      "constraint": { "name": "record {}", "builtin": true },
                      "shapes": [
                        { "form": "array", "element": "bare" },
                        { "form": "stream", "element": "bare", "completionType": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "$service.onFileCsv.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              },
              {
                "id": "$service.onFileCsv.fileInfo",
                "name": "fileInfo",
                "doc": "The file's name, path, size, timestamps, and attributes.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": { "id": "$service.onFileCsv.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          },
          {
            "id": "$service.onFile",
            "name": "onFile",
            "kind": "remote",
            "doc": "Invoked for any file no typed handler matched, and as the fallback when a typed handler is not declared. Content arrives as raw bytes.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "id": "$service.onFile.content",
                "name": "content",
                "doc": "The file's bytes. Declare the stream form to read large files in chunks rather than loading them into memory.",
                "type": [
                  { "shape": "array", "elementType": { "name": "byte", "builtin": true } },
                  {
                    "shape": "stream",
                    "elementType": { "shape": "array", "elementType": { "name": "byte", "builtin": true } },
                    "completionType": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }]
                  }
                ],
                "presence": "required"
              },
              {
                "id": "$service.onFile.caller",
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              },
              {
                "id": "$service.onFile.fileInfo",
                "name": "fileInfo",
                "doc": "The file's name, path, size, timestamps, and attributes.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": { "id": "$service.onFile.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          },
          {
            "id": "$service.onFileDelete",
            "name": "onFileDelete",
            "kind": "remote",
            "doc": "Invoked when a file disappears from the watched directory. There is no content and no file metadata, because the file is already gone.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "id": "$service.onFileDelete.path",
                "name": "path",
                "doc": "Path of the file that was deleted.",
                "type": { "name": "string", "builtin": true },
                "presence": "required"
              },
              {
                "id": "$service.onFileDelete.caller",
                "name": "caller",
                "doc": "The share connection, for acting on the share in response to the deletion.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onFileDelete.returns",
              "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }]
            }
          },
          {
            "id": "$service.onError",
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when the listener fails to poll, read, or bind a file, and when a handler itself returns an error. Without it, failures are logged and polling continues.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onError.err",
                "name": "err",
                "doc": "The failure that interrupted processing.",
                "type": { "name": "Error" },
                "presence": "required"
              },
              {
                "id": "$service.onError.caller",
                "name": "caller",
                "doc": "The share connection, for acting on the share while handling the failure.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": { "id": "$service.onError.returns", "type": [{ "name": "error", "builtin": true }, { "name": "()", "builtin": true }] }
          }
        ]
      },
      "rules": [
        {
          "id": "$atLeastOneFileHandler",
          "rule": "structure.atLeastOne",
          "message": "An SMB service must declare at least one onFile* handler or onFileDelete, otherwise nothing is ever dispatched. onError alone does not count.",
          "subjects": [
            { "kind": "handler", "id": "$service.onFileText" },
            { "kind": "handler", "id": "$service.onFileJson" },
            { "kind": "handler", "id": "$service.onFileXml" },
            { "kind": "handler", "id": "$service.onFileCsv" },
            { "kind": "handler", "id": "$service.onFile" },
            { "kind": "handler", "id": "$service.onFileDelete" }
          ]
        },
        {
          "id": "$pathSource",
          "rule": "structure.exactlyOne",
          "message": "An SMB service needs its watched path from exactly one source: @smb:ServiceConfig { path } or the service identifier.",
          "subjects": [
            { "kind": "annotationField", "annotation": "$serviceConfig", "path": ["path"], "role": "fromAnnotation" },
            { "kind": "identifier" }
          ],
          "prefer": "fromAnnotation"
        }
      ]
    }
  ],

  "annotations": [
    { "id": "$serviceConfig", "type": { "name": "ServiceConfig" }, "attachPoint": "service", "presence": "required" },
    { "id": "$functionConfig", "type": { "name": "FunctionConfig" }, "attachPoint": "function", "presence": "required" }
  ]
}
