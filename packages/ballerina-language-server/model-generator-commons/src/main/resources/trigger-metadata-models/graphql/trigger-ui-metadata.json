{
  "version": "v1.0",
  "metadata": {
    "kind": "graphql"
  },
  "trigger": {
    "displayName": "GraphQL"
  },
  "listeners": [
    {
      "target": "$listener"
    }
  ],
  "serviceTypes": [
    {
      "target": "$service",
      "handlers": [
        {
          "target": "$service.query",
          "parameters": [
            {
              "target": "$service.query.fieldArg"
            }
          ],
          "returnType": {
            "target": "$service.query.returns"
          }
        },
        {
          "target": "$service.mutation",
          "parameters": [
            {
              "target": "$service.mutation.fieldArg"
            }
          ],
          "returnType": {
            "target": "$service.mutation.returns"
          }
        },
        {
          "target": "$service.subscription",
          "parameters": [
            {
              "target": "$service.subscription.fieldArg"
            }
          ],
          "returnType": {
            "target": "$service.subscription.returns"
          }
        }
      ]
    }
  ],
  "artifactInfo": {
    "displayLabel": "GraphQL Service",
    "icon": {
      "lightPath": "icons/light.svg",
      "darkPath": "icons/dark.svg",
      "color": "#e535ab"
    },
    "identifier": {
      "separator": " - ",
      "resolvers": [
        {
          "via": "servicePath"
        }
      ]
    }
  }
}
